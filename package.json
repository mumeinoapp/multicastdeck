{
  "name": "multicastdeck",
  "version": "0.2.6",
  "description": "Twitch/YouTube/Kick マルチストリーム＋チャット統合＋Drops自動化デスクトップアプリ「MultiCastDeck」",
  "author": "yato",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "clean:release": "node -e \"require('fs').rmSync('release', { recursive: true, force: true })\"",
    "prebuild": "npm run clean:release",
    "build": "electron-builder",
    "prebuild:win": "npm run clean:release",
    "build:win": "electron-builder --win",
    "prerelease": "npm run clean:release",
    "release": "electron-builder --win --publish always"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.mumeinoapp.multicastdeck",
    "productName": "MultiCastDeck",
    "copyright": "Copyright © 2026 yato",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "icon": "build/icon.ico",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": "AppImage"
    },
    "publish": {
      "provider": "github",
      "owner": "mumeinoapp",
      "repo": "multicastdeck"
    }
  },
  "allowScripts": {
    "electron@31.7.7": true
  }
}
